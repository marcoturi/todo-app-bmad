# Docker Compose environment variables
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env

# PostgreSQL credentials (used by postgres service and api service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=todos

# API service
FRONTEND_URL=http://localhost:80
LOG_LEVEL=info

# Web service (build arg — baked into the frontend bundle at image build time)
# For local Docker dev use the host-accessible URL (localhost + exposed host port)
VITE_API_URL=http://localhost:3000

# Test profile: override POSTGRES_DB to use an isolated test database
# Usage: POSTGRES_DB=todos_test docker compose --profile test up
# POSTGRES_DB=todos_test
