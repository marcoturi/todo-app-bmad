{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "root": false,
  "extends": ["../../biome.json"],
  "formatter": {
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "correctness": {
        "noGlobalDirnameFilename": "error",
        "noUndeclaredVariables": "error",
        "useImportExtensions": "error"
      }
    },
    "includes": ["**", "!.dependency-cruiser.cjs", "!cucumber.setup.js"]
  },
  "files": {
    "includes": ["!.dependency-cruiser.cjs", "!cucumber.setup.js"]
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/test/**/*.ts",
        "**/tests/**/*.ts",
        "**/*.k6.ts"
      ],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noExplicitAny": "off" },
          "security": { "noSecrets": "off" }
        }
      }
    },
    {
      "includes": ["*.config.{js,ts,mjs}", ".*.{js,ts,mjs}", "scripts/**/*"],
      "linter": {
        "rules": { "correctness": { "noGlobalDirnameFilename": "off" } }
      }
    }
  ]
}
