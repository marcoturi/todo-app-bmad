{
  "name": "@todo-app/api",
  "version": "1.7.39",
  "description": "Todo App API - Fastify REST backend following Clean Architecture principles.",
  "author": "Marco Turi <marco.turi@hotmail.it>",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "create:env": "node -e \"require('fs').copyFileSync('.env.example', '.env', require('fs').constants.COPYFILE_EXCL)\"",
    "start": "node --env-file=.env --import ./src/instrumentation.ts --watch src/index.ts | pino-pretty -clSt",
    "start:prod": "node --env-file=.env --import ./src/instrumentation.ts ./src/index.ts",
    "start:ci": "node --import ./src/instrumentation.ts ./src/index.ts",
    "test": "pnpm test:unit",
    "test:coverage": "c8 --check-coverage --lines 70 --functions 70 --branches 70 --statements 70 --reporter=text --reporter=lcov node --test 'src/**/*.spec.ts'",
    "test:unit": "node --test 'src/**/*.spec.ts'",
    "test:e2e": "FASTIFY_AUTOLOAD_TYPESCRIPT=1 cucumber-js --exit",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "type:check": "tsc --noEmit",
    "check": "biome check && tsc --noEmit",
    "check:fix": "biome check --write && tsc --noEmit",
    "db": "dbmate h",
    "db:create-migration": "dbmate new",
    "db:migrate": "dbmate -e DBMATE_DATABASE_URL --no-dump-schema up",
    "db:create-seed": "dbmate -e DBMATE_DATABASE_URL -d ./db/seeds/ new",
    "db:seed": "dbmate -e DBMATE_DATABASE_URL -d ./db/seeds/ up",
    "db:seed:users": "k6 run ./tests/user/create-user/create-user.k6.ts",
    "deps:validate": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "deps:graph": "depcruise src --include-only \"^src\" --config --output-type dot | dot -T svg > doc/dependency-graph.svg",
    "semantic-release": "semantic-release"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "dependencies": {
    "@fastify/autoload": "6.4.0",
    "@fastify/awilix": "8.2.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/otel": "0.20.1",
    "@fastify/request-context": "6.2.1",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "5.2.6",
    "@fastify/type-provider-typebox": "6.1.0",
    "@fastify/under-pressure": "9.0.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/instrumentation": "0.219.0",
    "@opentelemetry/instrumentation-http": "0.219.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "@todo-app/shared": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "awilix": "13.0.5",
    "env-schema": "7.0.0",
    "fastify": "5.8.5",
    "fastify-plugin": "5.1.0",
    "postgres": "3.4.9",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/k6": "1.7.0",
    "@types/node": "25.9.5",
    "c8": "10.1.3",
    "dbmate": "2.34.1",
    "dependency-cruiser": "17.4.3",
    "pino-pretty": "13.1.3"
  },
  "keywords": [
    "fastify",
    "domain-driven-design",
    "functional-programming",
    "vertical-slice-architecture",
    "cucumber",
    "clean-architecture",
    "typescript",
    "template",
    "boilerplate"
  ]
}
