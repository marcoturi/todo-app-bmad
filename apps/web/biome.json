{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "root": false,
  "extends": ["../../biome.json"],
  "formatter": {
    "lineWidth": 80
  },
  "linter": {
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "noNestedTernary": "off",
        "useBlockStatements": "off",
        "useConsistentTypeDefinitions": "off",
        "useFilenamingConvention": "off",
        "noEnum": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConfusingVoidType": "off"
      },
      "security": {
        "noSecrets": "off"
      },
      "nursery": {
        "noFloatingPromises": "off"
      }
    },
    "includes": [
      "**",
      "!commitlint.config.cjs",
      "!cucumber.mjs",
      "!public/mockServiceWorker.js"
    ]
  },
  "files": {
    "includes": ["!**/dist"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.{ts,tsx,mts,cts}"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "warn"
          },
          "style": {
            "noCommonJs": "off"
          }
        }
      }
    },
    {
      "includes": ["e2e/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@todo-app/shared/todos/schema": "Frontend must not import schema files. Use '@todo-app/shared/todos/types' instead.",
                  "@todo-app/shared/user/schema": "Frontend must not import schema files. Use '@todo-app/shared/user/types' instead."
                }
              }
            }
          }
        }
      }
    }
  ]
}
